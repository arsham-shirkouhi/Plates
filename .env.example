# WorkoutX Exercise API — https://workoutxapp.com
# Copy this file to .env and fill in your key. .env is gitignored.

WORKOUTX_API_KEY=YOUR_WORKOUTX_API_KEY

# Expo inlines EXPO_PUBLIC_* variables into the JS bundle at build time.
EXPO_PUBLIC_WORKOUTX_API_KEY=YOUR_WORKOUTX_API_KEY
EXPO_PUBLIC_WORKOUTX_API_BASE_URL=https://api.workoutxapp.com/v1

# FoodData Central key: keep it only in the Supabase Edge Function secret
# USDA_FDC_API_KEY=YOUR_DATA_GOV_KEY

# Meal-photo AI key: set only as a Supabase Edge Function secret, never here.
# GEMINI_API_KEY=AIza...
